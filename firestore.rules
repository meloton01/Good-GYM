rules_version = '2';

// Минимум доступа: всё, что не разрешено явно, запрещено.
service cloud.firestore {
  match /databases/{database}/documents {

    // Вход выполнен, а при входе по паролю email подтверждён.
    function isVerifiedUser() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'password'
            || request.auth.token.email_verified == true);
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Роли, которые клиент может выставить сам; coach и moderator выдаёт только администрация.
    function isSelectableRole(role) {
      return role in ['athlete', 'student'];
    }

    function isVisibility(value) {
      return value in ['everyone', 'gymMembers', 'onlyMe'];
    }

    function isValidNickname(nickname) {
      return nickname is string && nickname.matches('^[a-z0-9_.]{3,20}$');
    }

    function isTextOfLength(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function nicknamePath(nickname) {
      return /databases/$(database)/documents/nicknames/$(nickname);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function blockPath(ownerId, blockedId) {
      return /databases/$(database)/documents/users/$(ownerId)/blocks/$(blockedId);
    }

    // Ни один из пользователей не заблокировал другого.
    function noBlockBetween(firstId, secondId) {
      return !exists(blockPath(firstId, secondId)) && !exists(blockPath(secondId, firstId));
    }

    function isMuscleGroup(value) {
      return value in ['chest', 'back', 'legs', 'shoulders', 'arms', 'core'];
    }

    // Список из min..max элементов; содержимое подходов проверяет клиент, документ виден только владельцу.
    function isListOfSize(value, min, max) {
      return value is list && value.size() >= min && value.size() <= max;
    }

    // Завершённая тренировка: даты по порядку, до 30 упражнений.
    function isValidWorkout(data) {
      return data.keys().hasOnly(['title', 'note', 'startedAt', 'finishedAt', 'exerciseIds', 'exercises', 'planId'])
        && data.keys().hasAll(['title', 'note', 'startedAt', 'finishedAt', 'exerciseIds', 'exercises'])
        && (data.get('planId', null) == null || data.planId is string)
        && isTextOfLength(data.title, 1, 60)
        && isTextOfLength(data.note, 0, 1000)
        && data.startedAt is timestamp
        && data.finishedAt is timestamp
        && data.finishedAt >= data.startedAt
        && data.finishedAt <= request.time + duration.value(1, 'd')
        && isListOfSize(data.exerciseIds, 1, 30)
        && isListOfSize(data.exercises, 1, 30);
    }

    function isValidTemplate(data) {
      return data.keys().hasOnly(['title', 'titleLower', 'exercises', 'updatedAt'])
        && isTextOfLength(data.title, 1, 60)
        && data.titleLower == data.title.lower()
        && isListOfSize(data.exercises, 1, 30)
        && data.updatedAt == request.time;
    }

    function isValidCustomExercise(data) {
      return data.keys().hasOnly(['name', 'nameLower', 'muscleGroup', 'createdAt'])
        && data.keys().hasAll(['name', 'nameLower', 'muscleGroup', 'createdAt'])
        && isTextOfLength(data.name, 2, 40)
        && data.nameLower == data.name.lower()
        && isMuscleGroup(data.muscleGroup)
        && data.createdAt == request.time;
    }

    // Показатель рекорда: значение, тренировка и дата, или null.
    function isRecordValue(value) {
      return value == null
        || (value is map
            && value.keys().hasOnly(['value', 'workoutId', 'achievedAt'])
            && value.value is number
            && value.value >= 0
            && value.value <= 100000
            && value.workoutId is string
            && value.achievedAt is timestamp);
    }

    function isValidRecord(exerciseId, data) {
      return data.keys().hasOnly(['exerciseId', 'muscleGroup', 'customName', 'maxWeightKg', 'bestE1rmKg', 'maxReps'])
        && data.exerciseId == exerciseId
        && isMuscleGroup(data.muscleGroup)
        && (data.get('customName', null) == null || isTextOfLength(data.customName, 2, 40))
        && isRecordValue(data.get('maxWeightKg', null))
        && isRecordValue(data.get('bestE1rmKg', null))
        && isRecordValue(data.get('maxReps', null));
    }

    function linkPath(linkId) {
      return /databases/$(database)/documents/coachLinks/$(linkId);
    }

    function studentCoachPath(athleteId) {
      return /databases/$(database)/documents/studentCoach/$(athleteId);
    }

    function coachStudentsPath(coachId) {
      return /databases/$(database)/documents/coachStudents/$(coachId);
    }

    // Пользователь — тренер ученика athleteId, и связь сейчас активна.
    function isActiveCoachOf(athleteId) {
      return isVerifiedUser()
        && exists(studentCoachPath(athleteId))
        && get(studentCoachPath(athleteId)).data.coachId == request.auth.uid;
    }

    function isLinkParty(data) {
      return isVerifiedUser() && request.auth.uid in [data.coachId, data.athleteId];
    }

    // Роли и ники сторон совпадают с профилями: тренер связан с учеником.
    function hasValidLinkParties(data) {
      return data.coachId != data.athleteId
        && get(userPath(data.coachId)).data.role == 'coach'
        && get(userPath(data.athleteId)).data.role == 'student'
        && data.coachNickname == get(userPath(data.coachId)).data.nickname
        && data.athleteNickname == get(userPath(data.athleteId)).data.nickname;
    }

    // Число активных учеников тренера до записи.
    function activeStudents(coachId) {
      return exists(coachStudentsPath(coachId)) ? get(coachStudentsPath(coachId)).data.count : 0;
    }

    function isValidInvite(linkId, data) {
      return isLinkParty(data)
        && data.keys().hasOnly(['coachId', 'athleteId', 'coachNickname', 'athleteNickname', 'status', 'invitedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['coachId', 'athleteId', 'coachNickname', 'athleteNickname', 'status', 'invitedBy', 'createdAt', 'updatedAt'])
        && linkId == data.coachId + '_' + data.athleteId
        && data.status == 'pending'
        && data.invitedBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && hasValidLinkParties(data)
        && noBlockBetween(data.coachId, data.athleteId);
    }

    // Принять может только приглашённая сторона; ученик свободен, у тренера меньше 50 учеников.
    function isAccept(linkId, before, after) {
      return before.status == 'pending'
        && after.status == 'active'
        && request.auth.uid != before.invitedBy
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt'])
        && hasValidLinkParties(after)
        && noBlockBetween(before.coachId, before.athleteId)
        && !exists(studentCoachPath(before.athleteId))
        && getAfter(studentCoachPath(before.athleteId)).data.linkId == linkId
        && getAfter(coachStudentsPath(before.coachId)).data.count == activeStudents(before.coachId) + 1
        && getAfter(coachStudentsPath(before.coachId)).data.count <= 50;
    }

    // Разорвать активную связь может любая сторона; доступ тренера пропадает вместе с замком.
    function isEnd(before, after) {
      return before.status == 'active'
        && after.status == 'ended'
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt'])
        && !existsAfter(studentCoachPath(before.athleteId))
        && getAfter(coachStudentsPath(before.coachId)).data.count == activeStudents(before.coachId) - 1;
    }

    // После разрыва любая сторона может пригласить снова.
    function isReinvite(before, after) {
      return before.status == 'ended'
        && after.status == 'pending'
        && after.invitedBy == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['status', 'invitedBy', 'coachNickname', 'athleteNickname', 'updatedAt'])
        && hasValidLinkParties(after)
        && noBlockBetween(before.coachId, before.athleteId);
    }

    function isValidPlanContent(data) {
      return isTextOfLength(data.title, 1, 60)
        && isTextOfLength(data.note, 0, 1000)
        && isListOfSize(data.exercises, 1, 30);
    }

    function planPath(athleteId, planId) {
      return /databases/$(database)/documents/users/$(athleteId)/plans/$(planId);
    }

    // Ученик или его активный тренер, который составил план.
    function canAccessPlan(athleteId, plan) {
      return isOwner(athleteId)
        || (isActiveCoachOf(athleteId) && plan.coachId == request.auth.uid);
    }

    function gymPath(gymId) {
      return /databases/$(database)/documents/gyms/$(gymId);
    }

    // Зал не указан или указан существующий зал с тем же названием.
    function isValidGym(data) {
      return (data.get('gymId', null) == null && data.get('gymName', null) == null)
        || (data.gymId is string
            && exists(gymPath(data.gymId))
            && get(gymPath(data.gymId)).data.name == data.gymName);
    }

    // Поля, которые владелец меняет сам; у профилей с Этапа 1 их ещё может не быть.
    function hasValidEditableFields(data) {
      return isValidNickname(data.nickname)
        && isTextOfLength(data.get('bio', ''), 0, 300)
        && isVisibility(data.get('profileVisibility', 'everyone'))
        && isVisibility(data.get('recordsVisibility', 'everyone'))
        && isValidGym(data);
    }

    // Профиль виден по настройке владельца: всем, посетителям его зала или только ему; заблокированным не виден.
    function canViewProfile(uid, data) {
      return isOwner(uid)
        || (isVerifiedUser()
            && !exists(blockPath(uid, request.auth.uid))
            && (data.get('profileVisibility', 'everyone') == 'everyone'
                || (data.get('profileVisibility', 'everyone') == 'gymMembers'
                    && data.get('gymId', null) != null
                    && get(userPath(request.auth.uid)).data.get('gymId', null) == data.gymId)));
    }

    match /users/{uid} {
      allow read: if canViewProfile(uid, resource.data);

      // Профиль создаётся вместе с записью ника в одной транзакции; consentAt фиксирует согласие и возраст 16+.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'nickname', 'role', 'bio', 'profileVisibility', 'recordsVisibility',
             'consentAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll([
             'nickname', 'role', 'bio', 'profileVisibility', 'recordsVisibility',
             'consentAt', 'createdAt', 'updatedAt'])
        && request.resource.data.consentAt == request.time
        && hasValidEditableFields(request.resource.data)
        && isSelectableRole(request.resource.data.role)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(nicknamePath(request.resource.data.nickname)).data.uid == uid;

      // Клиент меняет роль только между атлетом и учеником; тренер и модератор свою роль не снимают.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'nickname', 'role', 'bio', 'gymId', 'gymName',
             'profileVisibility', 'recordsVisibility', 'updatedAt'])
        && hasValidEditableFields(request.resource.data)
        && (request.resource.data.role == resource.data.role
            || (isSelectableRole(request.resource.data.role)
                && isSelectableRole(resource.data.role)
                && !exists(studentCoachPath(uid))))
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.nickname == resource.data.nickname
            || (getAfter(nicknamePath(request.resource.data.nickname)).data.uid == uid
                && !existsAfter(nicknamePath(resource.data.nickname))));

      // Владелец удаляет свой профиль при удалении аккаунта.
      allow delete: if isOwner(uid);

      // Вес и рост: только владелец.
      match /private/body {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['weightKg', 'heightCm'])
          && (request.resource.data.get('weightKg', null) == null
              || (request.resource.data.weightKg is number
                  && request.resource.data.weightKg >= 30
                  && request.resource.data.weightKg <= 300))
          && (request.resource.data.get('heightCm', null) == null
              || (request.resource.data.heightCm is number
                  && request.resource.data.heightCm >= 100
                  && request.resource.data.heightCm <= 250));
      }

      // Тренировочные данные: читает и пишет только владелец.
      // Тренер читает тренировки и рекорды ученика, пока связь активна.
      match /workouts/{workoutId} {
        allow read: if isOwner(uid) || isActiveCoachOf(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWorkout(request.resource.data);
      }

      match /workoutTemplates/{templateId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTemplate(request.resource.data);
      }

      // Своё упражнение не меняется: его название уже скопировано в историю.
      match /exercises/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCustomExercise(request.resource.data);
        allow update: if false;
      }

      // Заблокированные пользователи: видит и меняет только владелец.
      match /blocks/{blockedId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && blockedId != uid
          && request.resource.data.keys().hasOnly(['nickname', 'createdAt'])
          && request.resource.data.keys().hasAll(['nickname', 'createdAt'])
          && request.resource.data.nickname == get(userPath(blockedId)).data.nickname
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /personalRecords/{exerciseId} {
        allow read: if isOwner(uid) || isActiveCoachOf(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidRecord(exerciseId, request.resource.data);
      }

      // Планы тренера лежат у ученика: тренер создаёт и меняет их только при активной связи.
      match /plans/{planId} {
        allow read: if canAccessPlan(uid, resource.data);

        allow create: if isActiveCoachOf(uid)
          && request.resource.data.keys().hasOnly(['coachId', 'coachNickname', 'title', 'note', 'exercises', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['coachId', 'coachNickname', 'title', 'note', 'exercises', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.coachId == request.auth.uid
          && request.resource.data.coachNickname == get(userPath(request.auth.uid)).data.nickname
          && request.resource.data.status == 'assigned'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && isValidPlanContent(request.resource.data);

        // Тренер правит невыполненный план, ученик только отмечает выполнение.
        allow update: if resource.data.status == 'assigned'
          && request.resource.data.updatedAt == request.time
          && ((isActiveCoachOf(uid)
               && resource.data.coachId == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'note', 'exercises', 'updatedAt'])
               && isValidPlanContent(request.resource.data))
              || (isOwner(uid)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workoutId', 'completedAt', 'updatedAt'])
               && request.resource.data.status == 'completed'
               && request.resource.data.workoutId is string
               && request.resource.data.completedAt == request.time));

        allow delete: if canAccessPlan(uid, resource.data);

        match /comments/{commentId} {
          allow read: if canAccessPlan(uid, get(planPath(uid, planId)).data);

          allow create: if canAccessPlan(uid, get(planPath(uid, planId)).data)
            && request.resource.data.keys().hasOnly(['authorId', 'authorNickname', 'text', 'createdAt'])
            && request.resource.data.keys().hasAll(['authorId', 'authorNickname', 'text', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorNickname == get(userPath(request.auth.uid)).data.nickname
            && isTextOfLength(request.resource.data.text, 1, 500)
            && request.resource.data.createdAt == request.time;

          // Автор удаляет свой комментарий, ученик удаляет комментарии вместе с планом.
          allow delete: if isOwner(uid)
            || (isVerifiedUser() && resource.data.authorId == request.auth.uid);
        }
      }
    }

    match /coachLinks/{linkId} {
      allow read: if isLinkParty(resource.data);

      allow create: if isValidInvite(linkId, request.resource.data);

      allow update: if isLinkParty(resource.data)
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.athleteId == resource.data.athleteId
        && request.resource.data.updatedAt == request.time
        && (isAccept(linkId, resource.data, request.resource.data)
            || isEnd(resource.data, request.resource.data)
            || isReinvite(resource.data, request.resource.data));

      // Отклонить или отозвать приглашение, удалить завершённую связь.
      allow delete: if isLinkParty(resource.data) && resource.data.status != 'active';
    }

    // Замок: у ученика один активный тренер. Существует ровно пока связь активна.
    match /studentCoach/{athleteId} {
      allow read: if isVerifiedUser()
        && (request.auth.uid == athleteId || resource.data.coachId == request.auth.uid);

      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['coachId', 'linkId'])
        && request.auth.uid in [request.resource.data.coachId, athleteId]
        && request.resource.data.linkId == request.resource.data.coachId + '_' + athleteId
        && getAfter(linkPath(request.resource.data.linkId)).data.status == 'active';

      allow delete: if isVerifiedUser()
        && request.auth.uid in [resource.data.coachId, athleteId]
        && getAfter(linkPath(resource.data.linkId)).data.status == 'ended';

      allow update: if false;
    }

    // Счётчик активных учеников тренера; меняется на 1 вместе с принятием или разрывом связи.
    match /coachStudents/{coachId} {
      allow read: if isVerifiedUser();

      allow create, update: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['count', 'linkId'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 50
        && getAfter(linkPath(request.resource.data.linkId)).data.coachId == coachId
        && request.auth.uid in [
             getAfter(linkPath(request.resource.data.linkId)).data.coachId,
             getAfter(linkPath(request.resource.data.linkId)).data.athleteId]
        && ((request.resource.data.count == activeStudents(coachId) + 1
             && get(linkPath(request.resource.data.linkId)).data.status == 'pending'
             && getAfter(linkPath(request.resource.data.linkId)).data.status == 'active')
            || (request.resource.data.count == activeStudents(coachId) - 1
             && get(linkPath(request.resource.data.linkId)).data.status == 'active'
             && getAfter(linkPath(request.resource.data.linkId)).data.status == 'ended'));

      allow delete: if false;
    }

    match /nicknames/{nickname} {
      allow read: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && isValidNickname(nickname)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.nickname == nickname;

      // Ник освобождает только владелец: при смене ника или удалении профиля.
      allow delete: if isVerifiedUser()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid))
            || getAfter(userPath(request.auth.uid)).data.nickname != nickname);

      allow update: if false;
    }

    match /gyms/{gymId} {
      allow read: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'city', 'creatorId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'nameLower', 'city', 'creatorId', 'createdAt'])
        && isTextOfLength(request.resource.data.name, 2, 60)
        && isTextOfLength(request.resource.data.city, 2, 60)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    function isModerator() {
      return isVerifiedUser() && get(userPath(request.auth.uid)).data.role == 'moderator';
    }

    // История рекордов пользователя видна по его настройке recordsVisibility; заблокированным не видна.
    function canViewRecordsOf(uid) {
      return isVerifiedUser()
        && !exists(blockPath(uid, request.auth.uid))
        && (get(userPath(uid)).data.get('recordsVisibility', 'everyone') == 'everyone'
            || (get(userPath(uid)).data.get('recordsVisibility', 'everyone') == 'gymMembers'
                && get(userPath(uid)).data.get('gymId', null) != null
                && get(userPath(request.auth.uid)).data.get('gymId', null) == get(userPath(uid)).data.gymId));
    }

    // Рекорды создаёт и меняет только сервер: статус approved с клиента не выставить.
    match /records/{recordId} {
      allow read: if isOwner(resource.data.uid)
        || isModerator()
        || (resource.data.status == 'approved' && canViewRecordsOf(resource.data.uid));

      allow write: if false;
    }

    function isReportReason(value) {
      return value in ['spam', 'abuse', 'cheating', 'inappropriate', 'other'];
    }

    // Жалоба на пользователя или на его рекорд; одна жалоба от автора на одну цель.
    function isValidReportTarget(reportId, data) {
      return (data.get('recordId', null) == null
              && reportId == request.auth.uid + '_user_' + data.targetUid)
        || (data.recordId is string
            && reportId == request.auth.uid + '_record_' + data.recordId
            && get(/databases/$(database)/documents/records/$(data.recordId)).data.uid == data.targetUid);
    }

    // Жалобы разбирает модератор; автор видит и удаляет только свои.
    match /reports/{reportId} {
      allow read: if isModerator()
        || (isVerifiedUser() && resource.data.reporterId == request.auth.uid);

      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetUid', 'recordId', 'reason', 'comment', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterId', 'targetUid', 'reason', 'comment', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && exists(userPath(request.resource.data.targetUid))
        && isReportReason(request.resource.data.reason)
        && isTextOfLength(request.resource.data.comment, 0, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && isValidReportTarget(reportId, request.resource.data);

      allow update: if false;

      allow delete: if isVerifiedUser() && resource.data.reporterId == request.auth.uid;
    }

    // Лучшие одобренные результаты пользователей; пишут только функции при одобрении.
    match /leaderboard/{entryId} {
      allow read: if isVerifiedUser();

      allow write: if false;
    }
  }
}
